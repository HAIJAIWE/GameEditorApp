{
  "name": "mobai",
  "version": "0.1.0",
  "private": true,
  "description": "墨白可视化编辑 —— monorepo（apps/desktop 应用 + packages/shared 共享包）",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/desktop run dev",
    "build": "npm --prefix apps/desktop run build",
    "test": "npm --prefix apps/desktop run test",
    "typecheck": "npm --prefix apps/desktop run typecheck",
    "lint": "npm --prefix apps/desktop run lint",
    "e2e": "npm --prefix apps/desktop run e2e"
  }
}
