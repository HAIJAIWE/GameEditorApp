{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "electron.vite.config.ts",
    "vite.renderer.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*"
  ],
  /**
   * DOM 组件测试（jsdom）单独用 `tsconfig.test-dom.json` 检查。
   *
   * 为什么不直接给本配置加 `DOM` 到 lib：那等于允许主进程代码在**类型层面**使用
   * `document` / `window` 等浏览器 API —— 主进程没有 DOM，这类代码运行时才炸，
   * 而且 eslint 的 `no-undef` 对 TS 关闭，抓不到。宁多一个 tsconfig，不开这个洞。
   *
   * `tests/unit/*.test.tsx` 同理：它们是 jsdom 组件测试，落在 `dom/` 之外只是为了
   * 与同批新增的单测同目录，DOM 类型仍由 `tsconfig.test-dom.json` 提供。
   */
  "exclude": ["tests/unit/dom/**", "tests/unit/*.test.tsx"]
}