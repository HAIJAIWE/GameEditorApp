# 运行时产物（AI 向量库/学习库/导出与日志目录）
chroma/
vector_index/
perf/
*.db

# electron-vite 构建残留（转译出的临时 .mjs 配置，未跟踪但会污染 git status）
apps/desktop/electron.vite.config.*.mjs

# 本地运行产物：错位生成的嵌套库目录（如 cwd 不对时落出的 GameEditorApp/…/libraries）
GameEditorApp/
# spike 试跑输出（docx/pptx 样例）与目录本身，仅本地验证用
spikes/

# 依赖目录
node_modules/

# 第三方源码参考（dsh / deepseek-harness 仅作设计参考阅读，不进本仓库）
deepseek-harness-master/

# 本地运行数据（开发期库 / 草稿 / 设置 / 模板；应用运行时生成，不属于源码）
# 内含 data/libraries/{初始库,默认库,default,...}，约 1MB
data/

# Trae IDE 本地配置（空目录/规则，不参与版本管理）
.trae/

# 临时验证产物（导出试跑 / 逆向样例），仅本地验证用
.scratch/

# ── 凭据 / 私钥：一律不入库（开源协作前提）──────────────────────────
# 环境变量文件；只允许提交无真值的 .env.example 模板
.env
.env.*
!.env.example
# 证书与私钥
*.pem
*.key
*.pfx
*.p12
*.keystore
*.jks
*.ppk
id_rsa*
id_ed25519*
# 应用设置导出 / 旧版备份：可能含 api_key 明文或加密串
**/api_config*.json
*.legacy-bak
# 覆盖式补充：任何层级的数据目录（真正的运行时库与设置）
**/data/settings/

# electron-builder 构建资源（应用图标）：上面第 3 行的 `build/` 会连它一起忽略，这里放行
!apps/desktop/build/
